# ──────────────────────────────────────────
# AgroGestão — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o arquivo .env no git
# ──────────────────────────────────────────

# ── Frontend ──────────────────────────────
# URL da API REST (Spring Boot)
VITE_API_URL=http://localhost:8080/api/v1

# Ambiente: development | staging | production
VITE_APP_ENV=development

# Versão do app (exibida no rodapé)
VITE_APP_VERSION=2.1.0

# ── Backend (Spring Boot) ─────────────────
# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrogestao
DB_USER=postgres
DB_PASSWORD=change_me_in_production

# JWT
JWT_SECRET=change_me_use_at_least_64_chars_random_string
JWT_EXPIRATION_MS=86400000

# CORS — domínios autorizados (separados por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://agrogestao.com.br

# E-mail (SMTP — para notificações e recuperação de senha)
MAIL_HOST=smtp.hostgator.com.br
MAIL_PORT=465
MAIL_USER=noreply@agrogestao.com.br
MAIL_PASSWORD=change_me

# ── Produção (Hostgator) ──────────────────
# Preencher apenas no servidor / CI
FTP_HOST=ftp.agrogestao.com.br
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_PATH=/public_html
