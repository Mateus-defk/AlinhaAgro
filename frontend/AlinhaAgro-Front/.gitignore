# ──────────────────────────────────────────
# AgroGestão — .gitignore
# ──────────────────────────────────────────

# Variáveis de ambiente
.env
.env.local
.env.*.local

# Dependências
node_modules/
vendor/

# Build / dist
dist/
build/
out/
.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.idea/
.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Spring Boot (backend — quando criar)
backend/target/
backend/*.jar
backend/*.war
backend/.mvn/
backend/mvnw.cmd

# PostgreSQL / DB local
*.sql.bak
pgdata/

# Uploads locais
uploads/
tmp/

# Certificados e chaves
*.pem
*.key
*.crt
*.p12
*.pfx
